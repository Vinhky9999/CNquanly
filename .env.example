# --- Database ---
# Local Postgres (Docker / winget install — see README "Chạy lần đầu"):
DATABASE_URL="postgresql://cardnest:cardnest@localhost:5432/cardnest?schema=public"
DIRECT_URL="postgresql://cardnest:cardnest@localhost:5432/cardnest?schema=public"

# Neon (production / Vercel) — get both from the Neon dashboard's "Connection Details":
#   DATABASE_URL = the POOLED connection string (host ends in "-pooler"), used at runtime.
#                  Add "&pgbouncer=true" since Neon's pooler runs in PgBouncer transaction mode.
#   DIRECT_URL   = the DIRECT (non-pooled) connection string, used only by `prisma migrate`.
# DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/cardnest?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/cardnest?sslmode=require"

# 32+ char random string used to encrypt the session cookie
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Used only by prisma/seed.ts to create the initial admin account
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-please"
