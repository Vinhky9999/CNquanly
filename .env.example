DATABASE_URL="postgresql://cardnest:cardnest@localhost:5432/cardnest?schema=public"

# 32+ char random string used to encrypt the session cookie
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Used only by prisma/seed.ts to create the initial admin account
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-please"
