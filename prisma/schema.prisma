datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RawGrade {
  S
  A
  B
}

enum SingleCardCondition {
  RAW
  GRADED
}

enum InventoryStatus {
  IN_STOCK
  RESERVED
  SOLD
}

enum SealedStockStatus {
  IN_STOCK
  IN_TRANSIT
  PRE_ORDER
  ON_HOLD
}

enum TransactionType {
  PURCHASE
  SALE
}

enum OrderType {
  DIRECT
  DELIVERY
}

enum InventoryItemType {
  SEALED
  SINGLE
}

enum CashLedgerEntryType {
  PURCHASE
  SALE
  MANUAL_ADJUSTMENT
  WITHDRAWAL
  DEBT_REPAYMENT
  DEBT_COLLECTION
  GRADING_INCOME
  GRADING_COST
}

// ADVANCED_BY_PERSON: cá nhân ứng tiền túi mua hàng cho CardNest -> CardNest NỢ người đó (phải trả).
// ADVANCED_TO_PERSON: CardNest ứng tiền quỹ cho người đó đi mua hàng -> người đó NỢ CardNest (phải thu).
enum DebtType {
  ADVANCED_BY_PERSON
  ADVANCED_TO_PERSON
}

// Dịch vụ nhận gửi chấm điểm thẻ hộ khách: Chờ gửi hãng -> Đang chấm -> Đang vận chuyển về -> Đã trả khách.
enum GradingStatus {
  PENDING_SEND
  AT_GRADER
  SHIPPING_BACK
  COMPLETED
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GradingCompany {
  id          String       @id @default(cuid())
  name        String       @unique
  singleCards SingleCard[]
  createdAt   DateTime     @default(now())
}

model SealedProduct {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  game        String?
  quantity    Int      @default(0)
  costPrice   Decimal  @db.Decimal(14, 2)
  marketPrice Decimal? @db.Decimal(14, 2)
  // "tcgplayer:<productId>:<printing>:<categoryId>:<groupId>" — marketPrice (VND) follows TCGplayer when set.
  priceSource          String?
  priceSourceLabel     String? // tên sản phẩm TCGplayer đã khớp
  priceSourceUrl       String?
  priceMatchScore      Float? // 0..1 độ tin cậy khi tự khớp (1 = chọn tay)
  marketPriceUpdatedAt DateTime?
  priceLinkAttemptedAt DateTime?
  priceMatcherVersion  Int? // phiên bản bộ khớp TCGplayer đã thử lần cuối (khớp lại khi bộ khớp được nâng cấp)
  status      SealedStockStatus @default(IN_STOCK)
  imageUrl    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactionItems TransactionItem[]

  @@index([name])
  @@index([game])
}

model SingleCard {
  id        String              @id @default(cuid())
  sku       String              @unique
  cardName  String
  game      String?
  condition SingleCardCondition

  rawGrade RawGrade?

  gradingCompanyId String?
  gradingCompany   GradingCompany? @relation(fields: [gradingCompanyId], references: [id])
  certNumber       String?         @unique
  grade            Decimal?        @db.Decimal(3, 1)

  costPrice   Decimal  @db.Decimal(14, 2)
  marketPrice Decimal? @db.Decimal(14, 2)
  // "pokemontcg:<id>" | "scryfall:<id>" | "ygoprodeck:<id>" — when set, marketPrice is refreshed automatically.
  priceSource String?
  marketPriceUpdatedAt DateTime?
  priceSourceLabel     String?
  priceSourceUrl       String?
  priceMatchScore      Float?
  priceLinkAttemptedAt DateTime?
  priceMatcherVersion  Int? // phiên bản bộ khớp TCGplayer đã thử lần cuối (khớp lại khi bộ khớp được nâng cấp)
  quantity    Int      @default(1)
  imageUrl  String?

  status    InventoryStatus @default(IN_STOCK)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactionItems TransactionItem[]

  @@index([cardName])
  @@index([status])
  @@index([condition])
}

model CustomerTag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String?
  customers Customer[] @relation("CustomerToTag")
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  zalo         String?
  facebook     String?
  address      String?
  notes        String?
  tags         CustomerTag[] @relation("CustomerToTag")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([phone])
}

model Transaction {
  id              String          @id @default(cuid())
  type            TransactionType
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  transactionDate DateTime        @default(now())
  totalAmount     Decimal         @db.Decimal(14, 2)
  totalCost       Decimal?        @db.Decimal(14, 2) // cost-basis snapshot, SALE only — used to compute profit
  notes           String?
  createdAt       DateTime        @default(now())

  orderType        OrderType @default(DIRECT)
  trackingCode     String?
  shippingCarrier  String?
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?

  items           TransactionItem[]
  cashLedgerEntry CashLedgerEntry?

  @@index([transactionDate])
  @@index([customerId])
  @@index([orderType])
}

model TransactionItem {
  id              String            @id @default(cuid())
  transactionId   String
  transaction     Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemType        InventoryItemType
  sealedProductId String?
  sealedProduct   SealedProduct?    @relation(fields: [sealedProductId], references: [id])
  singleCardId    String?
  singleCard      SingleCard?       @relation(fields: [singleCardId], references: [id])
  quantity        Int               @default(1)
  unitPrice       Decimal           @db.Decimal(14, 2)
  subtotal        Decimal           @db.Decimal(14, 2)
  costBasis       Decimal?          @db.Decimal(14, 2) // cost-basis snapshot for this line, SALE only

  @@index([transactionId])
}

model CashLedgerEntry {
  id            String              @id @default(cuid())
  type          CashLedgerEntryType
  amount        Decimal             @db.Decimal(14, 2)
  balanceAfter  Decimal             @db.Decimal(14, 2)
  description   String?
  transactionId String?             @unique
  transaction   Transaction?        @relation(fields: [transactionId], references: [id])
  createdAt     DateTime            @default(now())

  debtPayment DebtPayment?

  gradingIncome GradingSubmission? @relation("GradingIncome")
  gradingCost   GradingSubmission? @relation("GradingCost")

  @@index([createdAt])
}

model Debt {
  id             String     @id @default(cuid())
  type           DebtType
  personName     String
  amount         Decimal    @db.Decimal(14, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(14, 2)
  referenceLabel String? // Mã SKU hoặc tên lô hàng TCG liên quan
  notes          String?
  status         DebtStatus @default(UNPAID)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  payments DebtPayment[]

  @@index([type])
  @@index([status])
  @@index([personName])
}

model DebtPayment {
  id                String           @id @default(cuid())
  debtId            String
  debt              Debt             @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount            Decimal          @db.Decimal(14, 2)
  note              String?
  cashLedgerEntryId String?          @unique
  cashLedgerEntry   CashLedgerEntry? @relation(fields: [cashLedgerEntryId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([debtId])
}

// Đơn nhận gửi chấm điểm hộ khách, gồm nhiều thẻ (GradingItem). Các cột cardName/company/tier/
// quantity/listedFee/costPrice/markup/chargeAmount là TỔNG HỢP của các thẻ, được tính lại mỗi lần lưu:
// chargeAmount (khách trả) = costPrice (giá gốc) + markup (lãi dịch vụ).
model GradingSubmission {
  id              String        @id @default(cuid())
  customerName    String
  customerContact String?
  cardName        String
  sku             String?
  certNumber      String?
  company         String // PSA | BGS | ARS | CGC | ...
  tier            String // Regular, Express, Bulk, Super Express...
  quantity        Int           @default(1)
  listedFee       Decimal       @db.Decimal(14, 2) // phí niêm yết của hãng
  costPrice       Decimal       @db.Decimal(14, 2) // giá gốc thực tế (phí hãng + vận chuyển/bảo hiểm)
  markup          Decimal       @db.Decimal(14, 2) // lãi dịch vụ
  chargeAmount    Decimal       @db.Decimal(14, 2) // khách phải trả = costPrice + markup
  status          GradingStatus @default(PENDING_SEND)
  notes           String?

  items GradingItem[]

  incomeEntryId String?          @unique
  incomeEntry   CashLedgerEntry? @relation("GradingIncome", fields: [incomeEntryId], references: [id], onDelete: SetNull)
  costEntryId   String?          @unique
  costEntry     CashLedgerEntry? @relation("GradingCost", fields: [costEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerName])
  @@index([createdAt])
}

// Một dòng thẻ trong đơn chấm điểm; số tiền là tổng của dòng đó (đã nhân số lượng nếu gửi nhiều bản).
model GradingItem {
  id           String            @id @default(cuid())
  submissionId String
  submission   GradingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  cardName     String
  game         String?
  sku          String?
  certNumber   String?
  company      String
  tier         String
  quantity     Int               @default(1)
  listedFee    Decimal           @default(0) @db.Decimal(14, 2)
  costPrice    Decimal           @db.Decimal(14, 2)
  markup       Decimal           @db.Decimal(14, 2)
  position     Int               @default(0)

  @@index([submissionId])
}

enum MessengerDirection {
  IN
  OUT
}

// Kết nối Meta Messenger Platform của Fanpage (một dòng duy nhất, id = "default").
model MessengerConfig {
  id              String   @id @default("default")
  appId           String?
  pageId          String?
  pageName        String?
  pageAccessToken String?
  appSecret       String?
  verifyToken     String
  updatedAt       DateTime @updatedAt
}

// Một hội thoại = một khách (PSID) nhắn tới Fanpage.
model MessengerConversation {
  id              String   @id @default(cuid())
  psid            String   @unique
  customerName    String
  profilePic      String?
  lastMessageText String?
  lastMessageAt   DateTime @default(now())
  unreadCount     Int      @default(0)
  isSimulated     Boolean  @default(false) // tạo từ giao diện mô phỏng, không gửi ra Messenger thật
  createdAt       DateTime @default(now())

  messages MessengerMessage[]

  @@index([lastMessageAt])
}

model MessengerMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessengerDirection
  text           String?
  imageUrl       String?
  mid            String?               @unique // id tin nhắn của Meta, chống trùng khi webhook gửi lại
  status         String                @default("SENT") // SENT | LOCAL (chưa gửi ra Messenger) | FAILED
  error          String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}
